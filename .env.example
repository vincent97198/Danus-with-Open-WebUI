# The model must already be running. Use a URL reachable FROM Docker containers.
# Do not append /v1 or a trailing slash.
MODEL_BASE_URL=http://host.docker.internal:8080

# Copy the exact model ID returned by GET /v1/models.
MODEL_NAME=replace-with-your-model-id

# Keep this different from any existing installation's Compose project name.
COMPOSE_PROJECT_NAME=danus-webui
